# QPay merchant мэдээлэл. Хоосон бол MOCK горим (жинхэнэ төлбөргүй, туршилтын товчтой).
# Sandbox: https://merchant-sandbox.qpay.mn/v2   Production: https://merchant.qpay.mn/v2
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=

# Сайтын нийтэд нээлттэй хаяг (QPay callback ийш дуудна)
APP_URL=http://localhost:3000

# PLUS үнэ (₮) болон хугацаа (хоног)
PLUS_PRICE=20000
PLUS_DAYS=30

# Supabase Postgres холболтын хаяг (Project Settings → Database → Connection string → Transaction pooler, порт 6543).
# Хоосон бол локал туршилтын PGlite ашиглана (зөвхөн компьютер дээр). Vercel дээр ЗААВАЛ тохируулна.
DATABASE_URL=

# ---- Гар баталгаажуулах горим (QPay merchant API байхгүй үед) ----
# QR зургаа public/pay-qr.png гэж хийгээд доорх мөрийг идэвхжүүлнэ.
# MANUAL_QR=/pay-qr.png
# Админ хуудас (/app/admin.html)-д нэвтрэх имэйлүүд (таслалаар)
# ADMIN_EMAILS=you@example.com
